#!/bin/bash
# Volatile whole-PC power profiles for the validated Ryzen 7900X + NVIDIA GPU.
set -euo pipefail

readonly CPU_POWER=/usr/local/sbin/cpu-power
readonly NVIDIA_SMI=/usr/bin/nvidia-smi

die() {
  printf 'pc-power: %s\n' "$*" >&2
  exit 1
}

[[ ${EUID} -eq 0 ]] || die 'run as root (for example: sudo pc-power silent)'
[[ -x "$CPU_POWER" ]] || die "missing CPU controller: $CPU_POWER"
[[ -x "$NVIDIA_SMI" ]] || die "missing NVIDIA controller: $NVIDIA_SMI"

cpu_limits() {
  local pm
  pm=$("$CPU_POWER" status) || die 'CPU status read failed'
  CPU_PPT=$(awk -F': ' '/\(PPT_LIMIT\)/ {print $2; exit}' <<<"$pm")
  CPU_TDC=$(awk -F': ' '/\(TDC_LIMIT\)/ {print $2; exit}' <<<"$pm")
  CPU_EDC=$(awk -F': ' '/\(EDC_LIMIT\)/ {print $2; exit}' <<<"$pm")
  [[ -n ${CPU_PPT:-} && -n ${CPU_TDC:-} && -n ${CPU_EDC:-} ]] || die 'CPU PM-table limits unavailable'
}

gpu_limit() {
  GPU_LIMIT=$("$NVIDIA_SMI" --query-gpu=power.limit --format=csv,noheader,nounits | head -n1 | xargs) || die 'GPU power-limit read failed'
  GPU_LIMIT=$(printf '%.0f' "$GPU_LIMIT")
}

profile() {
  cpu_limits
  gpu_limit
  case "$CPU_PPT/$CPU_TDC/$CPU_EDC/$GPU_LIMIT" in
    88.0/75.0/150.0/175) printf 'SILENT' ;;
    142.0/110.0/170.0/220) printf 'BALANCED' ;;
    230.0/160.0/225.0/250) printf 'STOCK' ;;
    *) printf 'CUSTOM' ;;
  esac
}

show_status() {
  local mode
  mode=$(profile)
  printf 'Power Profile: %s\n\nCPU:\n' "$mode"
  "$CPU_POWER" status
  printf '\nGPU:\n'
  "$NVIDIA_SMI" --query-gpu=name,power.draw,power.limit,power.default_limit,power.min_limit,power.max_limit --format=csv
}

set_gpu() {
  local target=$1 old
  gpu_limit
  old=$GPU_LIMIT
  "$NVIDIA_SMI" -pl "$target" >/dev/null || die "GPU: failed to set ${target}W"
  gpu_limit
  [[ $GPU_LIMIT -eq $target ]] || die "GPU: readback mismatch (wanted ${target}W, got ${GPU_LIMIT}W)"
  printf 'GPU:\n%dW -> %dW  OK\n\n' "$old" "$GPU_LIMIT"
}

set_cpu() {
  local target=$1 label=$2
  cpu_limits
  printf 'CPU:\n%s -> %s\n' "${CPU_PPT}W PPT / ${CPU_TDC}A TDC / ${CPU_EDC}A EDC" "$label"
  "$CPU_POWER" "$target" || die "CPU: failed to set ${label}"
  printf 'OK\n\n'
}

case "${1:-}" in
  status)
    [[ $# -eq 1 ]] || die 'usage: pc-power {silent|balanced|stock|status}'
    show_status
    ;;
  silent)
    [[ $# -eq 1 ]] || die 'usage: pc-power {silent|balanced|stock|status}'
    printf 'Switching to SILENT...\n\n'
    set_gpu 175
    set_cpu 65 '65W Eco'
    [[ $(profile) == SILENT ]] || die 'profile readback mismatch after SILENT switch'
    printf 'Current profile: SILENT\n'
    ;;
  balanced)
    [[ $# -eq 1 ]] || die 'usage: pc-power {silent|balanced|stock|status}'
    printf 'Switching to BALANCED...\n\n'
    set_gpu 220
    set_cpu 105 '105W Eco'
    [[ $(profile) == BALANCED ]] || die 'profile readback mismatch after BALANCED switch'
    printf 'Current profile: BALANCED\n'
    ;;
  stock)
    [[ $# -eq 1 ]] || die 'usage: pc-power {silent|balanced|stock|status}'
    printf 'Switching to STOCK...\n\n'
    set_cpu 170 '170W'
    set_gpu 250
    [[ $(profile) == STOCK ]] || die 'profile readback mismatch after STOCK switch'
    printf 'Current profile: STOCK\n'
    ;;
  *) die 'usage: pc-power {silent|balanced|stock|status}' ;;
esac

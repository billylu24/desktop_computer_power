[controller]
# The daemon locates this device dynamically by its hwmon name.  Never use a
# hwmon number here because numbering changes across boots.
hwmon_name = it8689
cpu_fan_min_percent = 30
lower_fan_min_percent = 35
upper_fan_min_percent = 35

# Mapping is confirmed, but keep false until supervised active-PWM testing
# passes.  --dry-run never writes these channels.
enabled = false

[cpu]
# Confirmed physical mapping on the reference machine.
pwm_paths = pwm1
fan_inputs = fan1_input
names = CPU_FAN

[lower]
# Lower intake is GPU-led: max(Core, Junction, VRAM demand).
pwm_paths = pwm3
fan_inputs = fan3_input
names = LOWER_FAN

[upper]
# Upper airflow exhausts both CPU and GPU heat.
pwm_paths = pwm6
fan_inputs = fan6_input
names = UPPER_FAN

[controller]
# The daemon locates this device dynamically by its hwmon name.  Never use a
# hwmon number here because numbering changes across boots.
hwmon_name = it8689
cpu_fan_min_percent = 30
sys_fan_min_percent = 35

# Keep false until the CPU/SYS header groups are physically identified.
# --dry-run works with an unmapped/disabled configuration.
enabled = false

[cpu]
# Comma-separated, positionally paired lists.  CPU_FAN + CPU_OPT can both be
# listed here when they are independently writable.
pwm_paths = UNMAPPED
fan_inputs = UNMAPPED
names = CPU_FAN

[sys]
# Every listed SYS header receives exactly the same target percentage.
pwm_paths = UNMAPPED
fan_inputs = UNMAPPED
# Optional; leave empty to generate SYS_FAN_1, SYS_FAN_2, ... automatically.
names =
